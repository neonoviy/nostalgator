SERVER_PORT=3001
ORIGINALS_PATH=/data/Originals
THUMBNAILS_PATH=/data/Thumbnails
IMPORT_PATH=/data/Import
DATABASE_URL=file:/data/Thumbnails/nostalgator.db
NODE_ENV=production
PYTHON_PATH=python3
AUTODETECT_FACES=true
AUTODETECT_PLACES=true
ORIGINALS_READONLY=false
FACE_CHUNK_SIZE=200
FACE_CHUNK_TIMEOUT=600
FACE_RETRY_ATTEMPTS=1
FACE_MATCH_THRESHOLD=0.6
FACE_DETECT_THRESH=0.6
# Максимальная сторона изображения для детекции лиц (меньше = быстрее preprocessing на CPU)
FACE_MAX_DETECT_DIM=1920
# Количество CPU-потоков для onnxruntime (меньше = меньше CPU нагрузка)
FACE_ORT_THREADS=4
FACE_TIMING=false
FACE_PERSISTENT=true
FACE_MODEL_RESET_INTERVAL=1000
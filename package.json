{
  "name": "nostalgator",
  "version": "2.0.0-alpha",
  "description": "Nostalgator - Photo and Video Archive Viewer",
  "main": "src/server/index.js",
  "scripts": {
    "dev": "vite --config vite.config.js",
    "build": "vite build --config vite.config.js",
    "preview": "vite preview --config vite.config.js",
    "server": "node -r dotenv/config src/server/index.js",
    "dev-all": "concurrently \"npm run server\" \"wait-on tcp:3001 && npm run dev\"",
    "init-env": "node scripts/init-env.js",
    "setup": "npm run init-env && npx prisma generate && npx prisma migrate dev --name init",
    "db:reset": "npx prisma migrate reset --force",
    "db:seed": "node -r dotenv/config prisma/seed.js",
    "import": "node scripts/import.js",
    "reset-password": "node scripts/reset-password.js",
    "docs": "node -e \"require('child_process').execSync('npx jsdoc ' + require('fs').readdirSync('src/server/services').filter(f=>f.endsWith('.js')).map(f=>'src/server/services/'+f).join(' ') + ' -d docs/jsdoc', {stdio:'inherit'})\"",
    "test": "node --test src/server/**/*.test.js",
    "lint": "eslint src/client/src src/server",
    "lint:fix": "eslint src/client/src src/server --fix",
    "format": "prettier --write \"src/client/src/**/*.{js,vue}\" \"src/server/**/*.js\"",
    "format:check": "prettier --check \"src/client/src/**/*.{js,vue}\" \"src/server/**/*.js\""
  },
  "dependencies": {
    "@fancyapps/ui": "^6.1.13",
    "@prisma/client": "^5.0.0",
    "@turf/turf": "^7.3.5",
    "@vuepic/vue-datepicker": "^12.1.0",
    "@vueuse/core": "^14.2.1",
    "all-the-cities": "^3.1.0",
    "bcrypt": "^6.0.0",
    "chokidar": "^3.5.3",
    "exiftool-vendored": "^35.15.1",
    "express": "^4.18.2",
    "fluent-ffmpeg": "^2.1.2",
    "geokdbush": "^1.1.0",
    "kdbush": "^3.0.0",
    "multer": "^2.1.1",
    "sharp": "^0.32.4",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "vue": "^3.3.4",
    "vue-i18n": "^9.14.5",
    "vue-router": "^4.2.4",
    "vue-select": "^4.0.0-beta.6",
    "vue-tippy": "^6.7.1",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-vue": "^5.0.0",
    "concurrently": "^8.0.0",
    "dotenv": "^16.6.1",
    "eslint": "^10.2.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.8.0",
    "jsdoc": "^4.0.5",
    "prettier": "^3.9.6",
    "prisma": "^5.0.0",
    "sass": "^1.98.0",
    "vite": "^5.0.0",
    "wait-on": "^8.0.5"
  }
}

# Пример файла конфигурации
# Скопируйте этот файл в .env и настройте под себя

# Пути к папкам (абсолютные или относительные)
ORIGINALS_PATH=./Originals
THUMBNAILS_PATH=./Thumbnails
IMPORT_PATH=./Import

# Формат названий папок для импорта
# Поддерживаемые: MM.DD, YYYY-MM-DD, YYYY.MM.DD
FOLDER_FORMAT=MM.DD

# Folder name format for imported events
# Supported: MM.DD, YYYY-MM-DD, YYYY.MM.DD
FOLDER_FORMAT=MM.DD

# Filename format for imported files (applies when moving from Import to Originals)
# Supported tokens: YYYY (year), MM (month), DD (day), HH (hour), mm (minute), ss (second), SSS (millisecond)
# Default: YYYYMMDD_HHmmssSSS -> e.g. 20240115_143022123
FILENAME_FORMAT=YYYYMMDD_HHmmssSSS

# Late-night cutoff (camera-clock hour). Photos taken at hour < LATE_NIGHT_HOUR
# are treated as belonging to the previous day. Default: 5 (00:00-04:59 -> prev day).
# Set to 0 to disable. Valid range: 0-23.
LATE_NIGHT_HOUR=5

# Upload limits (drag-and-drop / "Upload" menu item). Files stream to the
# Import folder via multer.diskStorage — no in-memory buffering. Unset = unlimited.
# UPLOAD_MAX_FILE_SIZE — bytes per file (e.g. 2147483648 for 2 GiB)
# UPLOAD_MAX_FILES    — number of files per request (e.g. 500)
# UPLOAD_MAX_FILE_SIZE=
# UPLOAD_MAX_FILES=

# Server ports
SERVER_PORT=3001
CLIENT_PORT=3000
VITE_SERVER_PORT=3001

# База данных (всегда хранится в папке Thumbnails)
DATABASE_URL=file:.${THUMBNAILS_PATH}/nostalgator.db

# Режим разработки
NODE_ENV=development

# === Автоматическое распознавание ===
# Автоматическое определение мест по фото/EXIF GPS
AUTODETECT_PLACES=true
# Автоопределение мест при повторном полном сканировании
NOMINATIM_ON_FULL_SCAN=false

# Автоматическое распознавание лиц
AUTODETECT_FACES=true
FACE_MATCH_THRESHOLD=0.55
# Размер батча изображений на один Python-процесс (меньше = меньше памяти и меньше риск таймаута)
FACE_CHUNK_SIZE=200
# Таймаут на один чанк в секундах (0 = без таймаута)
FACE_CHUNK_TIMEOUT=600
# Количество повторных попыток для проваленного чанка
FACE_RETRY_ATTEMPTS=1
# Порог детекции лиц в insightface (меньше = больше лиц, но больше шума)
FACE_DETECT_THRESH=0.6
# Максимальная сторона изображения для детекции лиц (меньше = быстрее preprocessing на CPU, рекомендуется 1920-2560)
FACE_MAX_DETECT_DIM=1920
# Количество CPU-потоков для onnxruntime (меньше = меньше CPU нагрузки, рекомендуется 4)
FACE_ORT_THREADS=4
# ctx_id для insightface: 0=GPU, -1=CPU. Автоопределяется если не задан.
FACE_CTX_ID=
# Чуть больше статистики в логе распознавания лиц
FACE_TIMING=false
# Распознавать лица сплоны потоком (быстрее), а не по событиям (надёжне). По умолчанию включено, отключить: FACE_PERSISTENT=false
FACE_PERSISTENT=true
# Очищать модель распознавание через каждые N фото. Чем выше, тем меньше пауз при распознавании, но тем выше вероятность ошибок.
FACE_MODEL_RESET_INTERVAL=1000
# === Первый запуск ===
# 1. Скопируйте этот файл в .env
# 2. Настройте пути (ORIGINALS_PATH, THUMBNAILS_PATH)
# 3. Выполните: npm run setup
# 4. Запустите: npm run server
